{
  "name": "mafs",
  "version": "0.22.0",
  "license": "MIT",
  "author": "Steven Petryk (https://stevenpetryk.com)",
  "description": "React components for interactive, animated math visualizations.",
  "keywords": [
    "math",
    "visualization",
    "react",
    "interactive",
    "animation"
  ],
  "homepage": "https://mafs.dev",
  "repository": "github:stevenpetryk/mafs",
  "source": "src/index.tsx",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.cjs"
    },
    "./core.css": "./core.css",
    "./font.css": "./font.css"
  },
  "types": "build/index.d.ts",
  "packageManager": "pnpm@10.7.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "files": [
    "build/",
    "fonts/",
    "core.css",
    "font.css"
  ],
  "scripts": {
    "start": "tsx scripts/dev.ts",
    "test": "pnpm -s test:unit && pnpm -s test:e2e",
    "test:unit": "vitest",
    "test:e2e": "tsx scripts/testgen.ts && playwright test",
    "build": "tsx scripts/build.ts",
    "build:docs": "pnpm -s docgen && cd docs && pnpm -s build",
    "docgen": "tsx scripts/docgen-cli.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:ts6": "tsc6 --noEmit",
    "api-report:update": "tsc && api-extractor run --local",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "tsx scripts/prepack.ts",
    "prepublishOnly": "pnpm test && pnpm lint && pnpm typecheck:ts6 && pnpm typecheck && pnpm build",
    "publish-branch": "tsx scripts/publish-branch.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@microsoft/api-extractor": "^7.52.7",
    "@playwright/experimental-ct-react": "~1.61.0",
    "@playwright/test": "~1.61.0",
    "@swc/core": "^1.11.24",
    "@types/fs-extra": "^11.0.4",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.7",
    "@typescript/native": "npm:typescript@^7.0.2",
    "esbuild": "^0.25.4",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.3.0",
    "happy-dom": "^17.6.3",
    "prettier": "^3.5.3",
    "react": "^18.3.1",
    "react-docgen-typescript": "2.2.2",
    "react-dom": "^18.3.1",
    "resize-observer-polyfill": "^1.5.1",
    "tsx": "^4.20.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.33.0",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@use-gesture/react": "^10.3.1",
    "katex": "^0.16.22",
    "tiny-invariant": "^1.3.3",
    "use-resize-observer": "^9.1.0"
  }
}
