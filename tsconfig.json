{
  "compilerOptions": {
    "declaration": true,
    "declarationDir": "build/types",
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "module": "esnext",
    "target": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": false,
    "skipLibCheck": true,
    "rootDir": "./",
    "types": []
  },
  "include": ["src/**/*", "e2e"]
}
